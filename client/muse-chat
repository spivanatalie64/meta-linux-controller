#!/usr/bin/env python3
"""muse-chat -- talk to Muse from a terminal on Natalie's PC.

Single-file, standard library only. Talks to the Meta Linux Controller
daemon on loopback (http://127.0.0.1:8771) with the token from
token.txt next to the daemon. Type a line, it is queued for Muse;
Muse's replies print here as they land, prefixed "Muse:".

Ctrl-C or Ctrl-D exits.
"""

import json
import os
import sys
import threading
import time
import urllib.request
import urllib.error

BASE = os.environ.get("MLC_BASE", "http://127.0.0.1:8771")
HERE = os.path.dirname(os.path.abspath(__file__))
TOKEN_FILE = os.environ.get(
    "MLC_TOKEN_FILE", os.path.join(HERE, "token.txt")
)
POLL_S = 2.0


def load_token():
    with open(TOKEN_FILE, "r", encoding="utf-8") as f:
        return f.read().strip()


TOKEN = load_token()


def call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        BASE + path, data=data, method=method,
        headers={"X-Token": TOKEN, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.loads(resp.read().decode())


stop = threading.Event()
cursor = [0]


def poller():
    while not stop.is_set():
        try:
            res = call("GET", f"/chat/outbox?after={cursor[0]}")
            for msg in res.get("messages", []):
                cursor[0] = max(cursor[0], msg["id"])
                print(f"\nClaude: {msg['text']}\n> ", end="", flush=True)
        except Exception:
            pass
        stop.wait(POLL_S)


def main():
    try:
        res = call("GET", "/chat/outbox")
        for msg in res.get("messages", []):
            cursor[0] = max(cursor[0], msg["id"])
    except Exception as e:
        print(f"muse-chat: cannot reach the controller daemon at {BASE} ({e})")
        print("Is meta-linux-controller.service running?")
        return 1
    print("muse-chat -- talk to Muse. Type a line and press Enter.")
    print("Replies print here as they land. Ctrl-C to exit.")
    t = threading.Thread(target=poller, daemon=True)
    t.start()
    try:
        while True:
            try:
                line = input("> ")
            except EOFError:
                break
            line = line.strip()
            if not line:
                continue
            try:
                call("POST", "/chat/send", {"text": line})
            except Exception as e:
                print(f"(could not send: {e})")
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
    print("\nmuse-chat: bye.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
