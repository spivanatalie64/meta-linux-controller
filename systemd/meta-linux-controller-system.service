# meta-linux-controller-system.service -- SYSTEM-unit variant.
#
# *** NOT INSTALLED. ***
#
# The installed unit is the systemd --user one
# (systemd/meta-linux-controller.service) plus linger (see
# enable-boot.sh): together they start the controller at boot with
# no root-owned unit at all. This system variant is kept only as a
# reference for anyone who would rather run it as a system service.
# Installing it would need root:
#   sudo cp systemd/meta-linux-controller-system.service \
#       /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meta-linux-controller-system
# Do not run both units at once -- they bind the same port.

[Unit]
Description=Meta Linux Controller daemon (system variant, not installed)
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=natalie
WorkingDirectory=/home/natalie/meta-linux-controller
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=MLC_PORT=8771
ExecStart=/usr/bin/python3 /home/natalie/meta-linux-controller/meta_linux_controllerd.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
